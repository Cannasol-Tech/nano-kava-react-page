rules_version = '2';

// Transcripts are written only by the Admin SDK inside the `chat` Cloud Function, and the Admin
// SDK bypasses these rules entirely. Nothing in a browser has any business reading a stranger's
// conversation, so the client surface is closed rather than scoped. See functions/lib/CLAUDE.md
// § Transcript persistence.
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
