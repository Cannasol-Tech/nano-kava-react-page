{
  "name": "nano-kava-landing-page",
  "private": true,
  "version": "1.3.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build && node scripts/prerender.mjs",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "perf:audit": "bash scripts/lighthouse-audit.sh",
    "prebuild": "node scripts/generate-seo-assets.mjs && node scripts/build-knowledge-base.mjs",
    "seo:assets": "node scripts/generate-seo-assets.mjs",
    "seo:indexnow": "node scripts/indexnow-submit.mjs",
    "kb": "node scripts/build-knowledge-base.mjs",
    "brand": "node scripts/brand/build.mjs public/brand && node scripts/brand/raster.mjs public/brand public/brand/png && node scripts/brand/ico.mjs public/brand/png public/brand/favicon.ico",
    "brand:contrast": "node scripts/brand/contrast.mjs"
  },
  "dependencies": {
    "lucide-react": "^0.294.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-helmet-async": "^2.0.5",
    "react-hot-toast": "^2.6.0",
    "react-router-dom": "^7.10.1",
    "web-vitals": "^5.1.0"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.1.0",
    "@testing-library/user-event": "^14.5.2",
    "@types/react": "^18.2.0",
    "@types/react-dom": "^18.2.0",
    "@vitejs/plugin-react": "^4.2.0",
    "autoprefixer": "^10.4.16",
    "jsdom": "^25.0.1",
    "postcss": "^8.4.32",
    "puppeteer": "^22.15.0",
    "tailwindcss": "^3.4.0",
    "vite": "^5.4.21",
    "vitest": "^2.1.8"
  },
  "allowScripts": {
    "puppeteer@22.15.0": true
  }
}
